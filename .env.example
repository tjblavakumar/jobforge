# JobForge Environment Configuration
# Copy this to .env or .streamlit/secrets.toml to configure

# OpenAI API Key (optional - if not set, app runs with local embeddings only)
OPENAI_API_KEY=sk-...

# Job Search Preferences
LOCATION=United States
MIN_SALARY=100000
EXP_LEVEL=senior

# Blacklist - comma-separated company names to exclude
BLACKLIST=

# Preferred Work Type (remote, hybrid, on-site)
WORK_TYPE=remote

# Search Freshness - jobs posted within last N days
FRESHNESS_DAYS=30

# Optional: seed demo jobs at startup (default false)
ENABLE_DEMO_SEED=false

# Job Alerts (Phase 3)
ALERTS_ENABLED=false
ALERT_MIN_SCORE=80
ALERT_MAX_ITEMS=10

# Optional SMTP settings for alert email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
